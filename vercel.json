{
  "version": 2,
  "buildCommand": "node scripts/build-blog.js",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/admin/blog",
      "destination": "/admin/blog/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/blog/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    }
  ]
}

