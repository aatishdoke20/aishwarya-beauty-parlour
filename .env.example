# Aishwarya Beauty Parlour - Blog CMS Environment Variables
# Copy this file to .env for local testing (NEVER commit .env to version control)
# On Vercel, set these in Project Settings -> Environment Variables

# Owner Admin Authentication
BLOG_ADMIN_EMAIL=owner@example.com
BLOG_ADMIN_PASSWORD=change_this_to_a_strong_password
BLOG_SESSION_SECRET=create_a_long_random_secret_at_least_32_characters

# GitHub Repository Integration (for Git-backed CMS publishing)
# Fine-grained personal access token with "Contents: Read & Write" permission for this repo
GITHUB_TOKEN=github_pat_xxxxxx
GITHUB_OWNER=aatishdoke20
GITHUB_REPO=aishwarya-beauty-parlour
GITHUB_BRANCH=main
